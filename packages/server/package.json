{
  "name": "@ugsl/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "bun server.js",
    "dev": "bun --watch server.js",
    "test": "bun --test test/*.test.js",
    "test:integration": "RUN_DB_TESTS=1 node --test test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@graphql-tools/merge": "^9.0.24",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "graphql": "^16.11.0",
    "graphql-scalars": "^2.0.0",
    "graphql-upload": "^18.0.0",
    "graphql-yoga": "^5.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^7.0.0"
  }
}
