# Container images published by the GitHub Actions workflow.
IMAGE_REPOSITORY=ghcr.io/8technologies/ugsl_learn
IMAGE_TAG=latest

# Local ports for a reverse proxy on the deployment server.
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=8080

# MariaDB container credentials. Use long, unique values.
DB_NAME=ugsl_learn
DB_USER=ugsl
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password

# URL-encode special characters in DB_PASSWORD here.
DATABASE_URL=mysql://ugsl:replace-with-a-random-password@database:3306/ugsl_learn
DB_CONNECTION_LIMIT=5

JWT_SECRET=replace-with-at-least-32-random-bytes
CLIENT_URL=https://staging.8jobspot.com
CORS_ORIGINS=https://staging.8jobspot.com,https://admin.staging.8jobspot.com
